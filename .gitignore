.claude/
__pycache__/
*.pyc
.venv/
audio/
*.log

# One-off investigation artefacts: scratch transcripts and probe scripts stay
# local, same convention as the scripts/_*.py probes.
episodes/_scratch_*
scripts/_*.py
audio/_*
data/_*
# Review artefacts written at the repo root. ROSTER_DIFF.txt reached a commit before
# this line existed, so name the shape rather than trusting the habit.
*_DIFF.txt
*_diff.txt
# Never commit credentials. A `git add -A` once swept scratch logs into this repo,
# so the filenames a key is most likely to land in are blocked by name rather than
# left to discipline. GitHub secret scanning and push protection are the backstop.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
*credentials*.json
*secret*.json
*token*.json
apikey*
api_key*
.netrc
