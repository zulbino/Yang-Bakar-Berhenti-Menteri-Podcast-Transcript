 "findings": {
  "word_gaps_beat_the_diarizer_on_boundaries": {
   "measurement": "boundary recall against the 16 gold speaker changes, +/-0.75s",
   "pyannote_threshold_055": "8/16 = 50%",
   "caption_word_gap_0.20s": "16/16 = 100% (147 candidates over 90s)",
   "caption_word_gap_0.50s": "16/16 = 100% (56 candidates over 90s)",
   "caption_word_gap_0.70s": "13/16 = 81%",
   "caption_word_gap_1.00s": "10/16 = 62%",
   "reading": "the caption track already knows where the turns are, because a turn change is a pause and YouTube timestamps every word. Over-segmenting about 3x is the right trade here: merge_same_speaker.py repairs over-segmentation, and nothing recovers words from a merge."
  },
  "single_reference_cosine_does_not_separate": {
   "measurement": "162 raw.md blocks >=3s scored by cosine against a Rafizi reference, gold region excluded",
   "rafizi_blocks": "n=80, range 0.473-0.927, median 0.830",
   "cohost_blocks": "n=66, range 0.448-0.919, median 0.794",
   "reading": "the two distributions sit on top of each other. On 3-second clips of one recording, raw cosine is dominated by room and channel rather than identity. Only the DIFFERENCE of two class means cancels the common component, which is why an axis needs both ends and why one voiceprint plus a threshold cannot work on this corpus.",
   "consequence": "this is why the POC needs a co-host seed at all, and why v1 and v2 failed"
  },
  "reference_contamination_in_ep61": {
   "claim": "6 of the 8 blocks raw.md labels Haziq at >=40s appear to be Rafizi",
   "method": "3 clips sampled from each block's interior, scored on the voice axis anchored by the owner's 18 gold turns",
   "mismatched_blocks_minutes": [
    139.1,
    76.6,
    114.4,
    45.9,
    149.7,
    147.7
   ],
   "correct_blocks_minutes": [
    28.9,
    104.2
   ],
   "rafizi_blocks_checked": "39 of 39 agree with their label, +0.14 to +0.36",
   "status": "NOT ADJUDICATED BY THE OWNER. This is a machine measurement against a 90-second gold passage, so it is a lead to check on video, not a fact to act on. No episode file has been touched.",
   "reading": "the same absorption defect as the gold passage, at block scale. It is also the direct reason a reference built from the co-host LABEL cannot be trusted here."
  },
  "yb_seed_supply_across_the_corpus": {
   "measurement": "count of YB tokens in each episode's raw.md body, 68 episodes",
   "median": 50,
   "mean": 51.8,
   "episodes_with_at_least_4": "68/68 = 100%",
   "episodes_with_at_least_8": "67/68 = 99%",
   "episodes_with_at_least_30": "57/68 = 84%",
   "ep61": 13,
   "reading": "ep61 has the second-thinnest seed supply in the corpus -- only ep05, at 6, is lower -- so 83% was reached close to the worst case, and the median episode has about 4x more seed material. This is the strongest available evidence that the method is not ep61-specific, but it is evidence about the SEED, not about the score."
  },
